# 忽略
.venv/
**/.venv/
__pycache__/
**/__pycache__/
*.pyc
.pytest_cache/
dist/
local.properties
android/.gradle/
android/build/
android/app/build/
*.iml
.idea/
.kotlin/

# ---- 凭据与签名材料：绝不进版本库 ----
# 签名私钥丢了就无法覆盖升级，泄露则任何人都能签发冒名 APK
android/keystore/
*.jks
*.keystore
keystore.properties
password.txt

# 本机凭据、端到端密钥、短期配对二维码
.secrets/
relay/devices.json
relay/registry.json
mcp-env.json
*.token
e2e.key

# 配对二维码只在项目根目录生成（配对 CLI 的默认输出位置）。
# 不能写全局的 pairing*.png/json——android/app/src/test/resources/ 下
# 有测试用的固定样本，被误伤会导致别人 clone 后跑不了单测。
/pairing*.png
/pairing*.json

# 日志与临时产物
*.log
.DS_Store
