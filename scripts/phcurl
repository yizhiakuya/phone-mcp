#!/usr/bin/env bash
# 用支持 TLS 1.3 的 curl 访问中继。
#
# 为什么需要它：Windows 10 自带 curl 走 Schannel，默认禁用 TLS 1.3 客户端，
# 而中继现在只接受 TLS 1.3（见 docs/security.md），所以系统 curl 会报
# SEC_E_UNSUPPORTED_FUNCTION。这里优先找 winget 装的 LibreSSL 版 curl。
#
# 用法与 curl 完全一致：
#   bash scripts/phcurl https://home.rainaki.top:8900/version.json
set -euo pipefail

CANDIDATES=(
    "$HOME/AppData/Local/Microsoft/WinGet/Packages/cURL.cURL_Microsoft.Winget.Source_8wekyb3d8bbwe"/*/bin/curl.exe
    "/c/Program Files/curl/bin/curl.exe"
)

for c in "${CANDIDATES[@]}"; do
    # shellcheck disable=SC2086
    if [ -x $c ] && "$c" --version 2>/dev/null | grep -qE 'LibreSSL|OpenSSL'; then
        exec "$c" "$@"
    fi
done

# 兜底：系统 curl。若中继仍只收 TLS 1.3，这里会失败并提示。
if curl --version 2>/dev/null | grep -qE 'LibreSSL|OpenSSL'; then
    exec curl "$@"
fi

echo "未找到支持 TLS 1.3 的 curl（当前 curl 走 Schannel）。" >&2
echo "安装：winget install --id cURL.cURL" >&2
echo "或改用：server/.venv/Scripts/python.exe -c \"import httpx; print(httpx.get(...))\" >&2
exit 1
